import 'package:drift/native.dart';
import 'package:excel/excel.dart';
import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:flutter_screenutil/flutter_screenutil.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:nex_ledger/core/constants/enums.dart';
import 'package:nex_ledger/core/database/app_database.dart';
import 'package:nex_ledger/core/database/database_provider.dart';
import 'package:nex_ledger/core/theme/app_theme.dart';
import 'package:nex_ledger/core/utils/excel_export_service.dart';
import 'package:nex_ledger/features/cash_book/data/cash_book_repository.dart';
import 'package:nex_ledger/features/purchase/data/purchase_invoice_repository.dart';
import 'package:nex_ledger/features/reports/data/input_gst.dart';
import 'package:nex_ledger/features/reports/presentation/input_gst_screen.dart';
import 'package:nex_ledger/features/subcontract/data/subcontract_repository.dart';

void main() {
  late AppDatabase db;

  setUp(() => db = AppDatabase(NativeDatabase.memory()));
  tearDown(() async => db.close());

  Future<void> seed() async {
    Future<int> project(String code) =>
        db.projectDao.insertProject(ProjectsCompanion.insert(
            code: code,
            name: 'Site $code',
            type: ProjectType.project,
            status: ProjectStatus.active,
            startDate: DateTime(2026, 1, 1)));
    final a = await project('PRJ-A');
    final b = await project('PRJ-B');
    final shop = await db.purchaseDao
        .insertVendor(VendorsCompanion.insert(name: 'Ganesh Traders'));
    final inv = PurchaseInvoiceRepository(db);
    await inv.createInvoice(PurchaseInvoiceDraft(
      date: DateTime(2026, 9, 5),
      invoiceNo: 'K-1',
      vendorId: shop,
      projectId: a,
      lines: const [
        InvoiceLineDraft(item: 'TMT Steel', qty: 100, rate: 100, gstRate: 18)
      ],
    ));
    await inv.createInvoice(PurchaseInvoiceDraft(
      date: DateTime(2026, 10, 10),
      invoiceNo: 'T-1',
      vendorId: shop,
      projectId: b,
      interState: true,
      lines: const [
        InvoiceLineDraft(item: 'Sand', qty: 200, rate: 50, gstRate: 12)
      ],
    ));
    final sub = SubcontractRepository(db.subcontractDao, db.transactionDao, db);
    final subId =
        await sub.addSubcontractor(name: 'Murugan Gang', trade: 'Plastering');
    final woId = await sub.createWorkOrder(
        orderNumber: 'WO-1',
        projectId: a,
        subcontractorId: subId,
        title: 'Plastering',
        trade: 'Plastering',
        unit: 'Sq.ft',
        agreedRate: 50,
        estimatedQuantity: 5000,
        retentionPercentage: 5,
        startDate: DateTime(2026, 8, 1));
    await sub.recordMeasurementBill(
        workOrderId: woId,
        billNumber: 'MB-01',
        date: DateTime(2026, 9, 20),
        measuredQuantity: 1000,
        unitRate: 50,
        gstRate: 18);
    final rentCat = (await (db.select(db.expenseCategories)
              ..where((c) => c.subCategory.equals('Equipment Rental')))
            .getSingle())
        .id;
    await CashBookRepository(db.transactionDao).addExpense(
        projectId: b,
        date: DateTime(2026, 10, 15),
        amount: 20000,
        expenseCategoryId: rentCat,
        gst: const ExpenseGstInput(rate: 18, partyName: 'Balaji Cranes'));
  }

  Future<void> pump(WidgetTester tester,
      {Size size = const Size(1500, 900)}) async {
    tester.view.physicalSize = size;
    tester.view.devicePixelRatio = 1.0;
    addTearDown(tester.view.reset);
    final container = ProviderContainer(
        overrides: [appDatabaseProvider.overrideWithValue(db)]);
    addTearDown(container.dispose);
    await tester.pumpWidget(UncontrolledProviderScope(
      container: container,
      child: ScreenUtilInit(
        designSize: const Size(1440, 900),
        builder: (context, _) =>
            MaterialApp(theme: AppTheme.light, home: const InputGstScreen()),
      ),
    ));
    for (var i = 0; i < 4; i++) {
      await tester
          .runAsync(() => Future.delayed(const Duration(milliseconds: 60)));
      await tester.pump(const Duration(milliseconds: 50));
    }
  }

  testWidgets(
      'By Project shows each project with its input GST and the split by source',
      (tester) async {
    await seed();
    await pump(tester);
    expect(find.text('Input GST Report'), findsOneWidget);
    // Project A: purchase 1,800 + subcontract 9,000 = 10,800. Project B: 1,200 (IGST) + 3,600 rent = 4,800.
    expect(find.text('₹10,800.00'), findsWidgets);
    expect(find.text('₹4,800.00'), findsWidgets);
    expect(find.text('₹15,600.00'), findsWidgets, reason: 'total input GST');
    // project costs incl. GST, the GST inside them, and costs without GST
    // A: 11,800 purchase + 59,000 subcontract = 70,800 (GST 10,800) -> 60,000
    // B: 11,200 purchase + 23,600 rent = 34,800 (GST 4,800) -> 30,000
    expect(find.text('₹70,800.00'), findsOneWidget);
    expect(
        find.text('₹60,000.00'), findsWidgets); // also equals A's taxable value
    expect(find.text('₹34,800.00'), findsOneWidget);
    expect(find.text('₹30,000.00'), findsWidgets);
    expect(find.text('PRJ-A'), findsOneWidget);
    expect(find.text('PRJ-B'), findsOneWidget);
    for (final h in [
      'Purchases',
      'Subcontractors',
      'Machinery Rent',
      'Other Expenses'
    ]) {
      expect(find.text(h), findsWidgets, reason: h);
    }
    expect(tester.takeException(), isNull);
  });

  testWidgets('By Source and All Entries views, and drilling down',
      (tester) async {
    await seed();
    await pump(tester);

    await tester.tap(find.text('By Source'));
    await tester.pump(const Duration(milliseconds: 400));
    expect(find.text('Input GST by Source'), findsOneWidget);
    await tester.tap(find.text('Subcontractors').last);
    await tester.pump(const Duration(milliseconds: 400));
    expect(find.text('GST Bills (1)'), findsOneWidget);
    expect(find.text('Murugan Gang'), findsOneWidget);
    expect(find.text('Clear filters'), findsOneWidget);

    await tester.tap(find.text('Clear filters'));
    await tester.pump(const Duration(milliseconds: 400));
    expect(find.text('GST Bills (4)'), findsOneWidget);
  });

  testWidgets('project filter shows one project', (tester) async {
    await seed();
    await pump(tester);
    await tester.tap(find.byKey(const ValueKey('igst-project-null')));
    await tester.pump(const Duration(milliseconds: 400));
    await tester.tap(find.textContaining('PRJ-B').last);
    await tester.pump(const Duration(milliseconds: 400));
    expect(find.text('PRJ-A'), findsNothing);
    expect(find.text('₹4,800.00'), findsWidgets);
  });

  testWidgets('empty database: friendly message and Export disabled',
      (tester) async {
    await pump(tester);
    expect(find.textContaining('No GST bills yet'), findsOneWidget);
    final export = tester.widget<FilledButton>(find.ancestor(
        of: find.textContaining('Export Excel'),
        matching: find.byWidgetPredicate((w) => w is FilledButton)));
    expect(export.onPressed, isNull);
  });

  for (final size in const [Size(1024, 700), Size(1280, 800)]) {
    testWidgets(
        'fits at ${size.width.toInt()}x${size.height.toInt()} in all views',
        (tester) async {
      await seed();
      await pump(tester, size: size);
      for (final v in ['By Source', 'All Entries', 'By Project']) {
        await tester.tap(find.text(v));
        await tester.pump(const Duration(milliseconds: 400));
        expect(tester.takeException(), isNull, reason: v);
      }
    });
  }

  test(
      'Excel workbook: by project, by source and every entry, with matching totals',
      () async {
    await seed();
    final entries = await InputGstRepository(db).loadEntries();
    // project ids are looked up by code, not assumed
    final a = (await (db.select(db.projects)
              ..where((p) => p.code.equals('PRJ-A')))
            .getSingle())
        .id;
    final b = (await (db.select(db.projects)
              ..where((p) => p.code.equals('PRJ-B')))
            .getSingle())
        .id;
    final excel = ExcelExportService.buildInputGstWorkbook(
        entries: entries,
        filterText: 'Project: All',
        projectCosts: {a: 70800, b: 34800});
    expect(
        excel.tables.keys.toSet(), {'By Project', 'By Source', 'All Entries'});

    String? v(Sheet sh, int r, int c) => sh.rows[r][c]?.value?.toString();
    double d(Sheet sh, int r, int c) => double.parse(v(sh, r, c)!);

    final byProject = excel.tables['By Project']!;
    expect(byProject.rows.length,
        4 + 1 + 2 + 1); // info, header, 2 projects, total
    expect(v(byProject, 5, 1), 'PRJ-A');
    expect([d(byProject, 5, 3), d(byProject, 5, 4), d(byProject, 5, 5)],
        [70800, 10800, 60000]);
    expect([d(byProject, 6, 3), d(byProject, 6, 4), d(byProject, 6, 5)],
        [34800, 4800, 30000]);
    expect(d(byProject, 5, 10), 10800); // total input GST for A
    expect(d(byProject, 6, 10), 4800);
    final total = byProject.rows.last;
    expect(total[1]?.value.toString(), 'TOTAL');
    expect(d(byProject, 7, 10), 15600);
    expect([d(byProject, 7, 3), d(byProject, 7, 4), d(byProject, 7, 5)],
        [105600, 15600, 90000]);
    // the by-source columns are in the same order as the enum: purchases, subcontract, machinery, expenses
    expect([
      d(byProject, 7, 11),
      d(byProject, 7, 12),
      d(byProject, 7, 13),
      d(byProject, 7, 14)
    ], [
      3000,
      9000,
      3600,
      0
    ]);

    final bySource = excel.tables['By Source']!;
    expect(bySource.rows.length, 4 + 1 + 3 + 1);
    expect(d(bySource, 8, 6), 15600);

    final all = excel.tables['All Entries']!;
    expect(all.rows.length, 4 + 1 + 4);
    expect(v(all, 4, 7), 'Taxable Value (₹)');
  });
}
