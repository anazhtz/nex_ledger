rules_version = '2';

// NexLedger license table.
//   licenses/{KEY}   one document per client company (the document id is the license key)
//   config/global    settings for everyone (maintenance switch, offline grace hours)
//
// Admin email: htzanaz@gmail.com (add more addresses inside the [ ] list if needed, comma separated).
// To change it: edit the email list in isAdmin() below, then paste all of this into
// Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['htzanaz@gmail.com'];
    }

    // The app reads these (it must know the document name, nobody can list them).
    match /config/{docId} {
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    match /licenses/{key} {
      // Only the "devices" field changes, it stays a map of at most 10
      // computers, and no computer that is already listed disappears.
      function isDeviceCheckIn() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['devices'])
          && request.resource.data.devices is map
          && request.resource.data.devices.size() <= 10
          && (!('devices' in resource.data)
              || request.resource.data.devices.keys().hasAll(resource.data.devices.keys()));
      }

      allow get: if true;
      allow list, create, delete: if isAdmin();

      // The app may only add or refresh its own computer under "devices":
      // it cannot change status, messages or limits, cannot remove computers,
      // and the list is capped at 10 entries.
      allow update: if isAdmin() || isDeviceCheckIn();
    }

    match /{other=**} {
      allow read, write: if false;
    }
  }
}
